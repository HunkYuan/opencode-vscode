{
  "name": "opencode-sidebar",
  "displayName": "OpenCode Sidebar",
  "description": "Community VS Code extension embedding the OpenCode UI and connecting to your shared local service.",
  "version": "0.1.0",
  "publisher": "opencode-local",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:opencodeSidebar.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeSidebar",
          "title": "OpenCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencodeSidebar": [
        {
          "id": "opencodeSidebar.chat",
          "name": "OpenCode",
          "type": "webview",
          "contextualTitle": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeSidebar.open",
        "title": "OpenCode: Open Sidebar"
      },
      {
        "command": "opencodeSidebar.newSession",
        "title": "OpenCode: New Session",
        "icon": "$(add)"
      },
      {
        "command": "opencodeSidebar.addFile",
        "title": "OpenCode: Add Current File"
      },
      {
        "command": "opencodeSidebar.addSelection",
        "title": "OpenCode: Add Selection"
      },
      {
        "command": "opencodeSidebar.review",
        "title": "OpenCode: Review Changes",
        "icon": "$(diff)"
      },
      {
        "command": "opencodeSidebar.reconnect",
        "title": "OpenCode: Reconnect",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodeSidebar.enableService",
        "title": "OpenCode: Enable Shared Service"
      },
      {
        "command": "opencodeSidebar.logs",
        "title": "OpenCode: Show Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeSidebar.newSession",
          "when": "view == opencodeSidebar.chat",
          "group": "navigation@1"
        },
        {
          "command": "opencodeSidebar.review",
          "when": "view == opencodeSidebar.chat",
          "group": "navigation@2"
        },
        {
          "command": "opencodeSidebar.reconnect",
          "when": "view == opencodeSidebar.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "opencodeSidebar.addSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "opencode@1"
        },
        {
          "command": "opencodeSidebar.addFile",
          "when": "resourceScheme == file",
          "group": "opencode@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencodeSidebar.open",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "opencodeSidebar.addSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "OpenCode Sidebar",
      "properties": {
        "opencodeSidebar.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the installed OpenCode executable. Empty uses PATH and the standard npm installation."
        },
        "opencodeSidebar.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the shared service when needed. The OpenCode service disabled setting always takes precedence."
        },
        "opencodeSidebar.followTheme": {
          "type": "boolean",
          "default": true,
          "description": "Follow the VS Code light or dark theme."
        }
      }
    }
  },
  "workspaces": {
    "packages": [
      ".upstream/packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.1",
      "@effect/platform-node": "4.0.1",
      "@effect/platform-node-shared": "4.0.1",
      "@effect/sql-sqlite-bun": "4.0.1",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.4.0",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@hono/standard-validator": "0.2.0",
      "@hono/zod-validator": "0.4.2",
      "@opentui/core": "0.6.6",
      "@opentui/keymap": "0.6.6",
      "@opentui/solid": "0.6.6",
      "@tanstack/solid-virtual": "3.13.37",
      "@standard-schema/spec": "1.1.0",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.13",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@pierre/diffs": "1.6.1",
      "@pierre/highlights": "0.2.0",
      "@solid-primitives/event-listener": "2.4.6",
      "@solid-primitives/media": "2.3.6",
      "@solid-primitives/resize-observer": "2.2.0",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.4",
      "dompurify": "3.4.14",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.0.1",
      "fast-check": "4.9.0",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "luxon": "3.6.1",
      "marked": "18.0.11",
      "marked-shiki": "1.2.1",
      "remend": "1.3.1",
      "@playwright/test": "1.60.0",
      "semver": "7.7.4",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "@typescript/native": "npm:typescript@7.0.2",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "sst": "4.13.1",
      "shiki": "4.4.3",
      "solid-list": "0.3.0",
      "string-width": "7.2.0",
      "tailwindcss": "4.1.11",
      "vite": "7.3.6",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "1.0.0",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@sentry/solid": "10.71.0",
      "@sentry/vite-plugin": "5.4.0",
