      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "oxlint src webview scripts test --ignore-path .gitignore",
    "check": "bun run lint && bun run typecheck",
    "test": "bun test test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "bun run build",
    "test:ui": "bun scripts/browser-smoke.ts && bun scripts/interaction-smoke.ts && bun scripts/session-smoke.ts",
    "test:service": "bun scripts/service-smoke.ts"
  },
  "devDependencies": {
    "@opencode/app": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/gui-extensions": "workspace:*",
    "@opencode/ui": "workspace:*",
