    "react": "19.2.0",
    "react-dom": "19.2.0",
    "scheduler": "0.27.0",
    "solid-js": "1.9.15",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.2",
    "vite-plugin-icons-spritesheet": "3.0.1",
    "vite-plugin-solid": "2.11.14",
    "ws": "^8.18.0",
    "zod": "4.1.8"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "prettier": {
